{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@slkiser/opencode-quota"
  ],
  "experimental": {
    "quotaToast": {
      "enableToast": true,
      "showSessionTokens": true,
      "enabledProviders": "auto",
      "formatStyle": "classic",
      "percentDisplayMode": "remaining"
    }
  },
  "provider": {
    "llamacpp": {
      "api": "openai",
      "name": "Qwen3.6 MTP Local",
      "options": {
        "baseURL": "http://127.0.0.1:58721/v1",
        "apiKey": "not-needed"
      },
      "models": {
        "qwen3.6-mtp": {
          "id": "qwen3.6-mtp",
          "tool_call": true,
          "reasoning": true,
          "temperature": true,
          "limit": {
            "context": 262144,
            "output": 8192
          },
          "cost": {
            "input": 0,
            "output": 0
          }
        }
      }
    }
  }
}
